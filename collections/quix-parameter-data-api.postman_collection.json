    {
      "id": "05727a73-09b0-4b28-a7ad-c821521f0248",
      "name": "Parameter Data",
      "description": {
        "content": "Publish time-series parameter data into a stream (Streaming Writer API).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "10efc806-a9f1-4f13-a9a6-9597b29c48b7",
          "name": "Send parameter data",
          "request": {
            "name": "Send parameter data",
            "description": {
              "content": "Publishes one or more time-series parameter samples to a stream. The payload carries an array of nanosecond `timestamps` plus values keyed by parameter name under `numericValues`, `stringValues`, and/or `binaryValues`. Publishing to a non-existent `streamId` implicitly creates the stream.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "topics",
                ":topicName",
                "streams",
                ":streamId",
                "parameters",
                "data"
              ],
              "host": [
                "writer-{{environmentId}}",
                "cloud",
                "quix",
                "io"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "topicName",
                  "description": "(Required) The name of the topic the stream belongs to."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "streamId",
                  "description": "(Required) The unique identifier of the stream. Publishing to an id that does not exist creates the stream implicitly."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamps\": [\n    \"<long>\",\n    \"<long>\"\n  ],\n  \"numericValues\": {\n    \"key_0\": [\n      \"<number>\",\n      \"<number>\"\n    ],\n    \"key_1\": [\n      \"<number>\",\n      \"<number>\"\n    ]\n  },\n  \"stringValues\": {\n    \"key_0\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"key_1\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"binaryValues\": {\n    \"key_0\": [\n      \"<byte>\",\n      \"<byte>\"\n    ],\n    \"key_1\": [\n      \"<byte>\",\n      \"<byte>\"\n    ],\n    \"key_2\": [\n      \"<byte>\",\n      \"<byte>\"\n    ]\n  },\n  \"tagValues\": {\n    \"key_0\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
