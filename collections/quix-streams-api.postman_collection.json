          "name": "Close a stream",
          "request": {
            "name": "Close a stream",
            "description": {
              "content": "Marks a stream as closed, signaling to consumers that no further data will be published. An optional end state (e.g. Closed, Aborted, Terminated) may be supplied.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "topics",
                ":topicName",
                "streams",
                ":streamId",
                "close"
              ],
              "host": [
                "writer-{{environmentId}}",
                "cloud",
                "quix",
                "io"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "topicName",
                  "description": "(Required) The name of the topic the stream belongs to."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "streamId",
                  "description": "(Required) The unique identifier of the stream. Publishing to an id that does not exist creates the stream implicitly."
