{
  "opencollection": "1.0.0",
  "info": {
    "name": "Quix Cloud HTTP APIs Definitions Workspaces API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Workspaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List workspaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://writer-{environmentId}.cloud.quix.io/workspaces",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the workspaces (environments) accessible to the authenticated account. (Portal API.)"
        },
        {
          "info": {
            "name": "Get a workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://writer-{environmentId}.cloud.quix.io/workspaces/:workspaceId",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "The workspace (environment) identifier."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns details for a single workspace. (Portal API.)"
        }
      ]
    }
  ],
  "bundled": true
}